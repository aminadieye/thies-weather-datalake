    "loss_names = [\"loss_classifier\", \"loss_box_reg\", \"loss_objectness\", \"loss_rpn_box_reg\"]\n",
    "loss_history = {name: [] for name in loss_names}\n",
    "\n",
    "for epoch in range(NUM_EPOCHS):\n",
